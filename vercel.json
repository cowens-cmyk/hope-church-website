{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "media.hopejc.org"
        }
      ],
      "destination": "https://hope-media.cowens-09f.workers.dev/"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "media.hopejc.org"
        }
      ],
      "destination": "https://hope-media.cowens-09f.workers.dev/$1"
    },
    {
      "source": "/sermons/:branch",
      "destination": "https://hope-media.cowens-09f.workers.dev/media/:branch"
    },
    {
      "source": "/sermons/:branch/:slug",
      "destination": "https://hope-media.cowens-09f.workers.dev/media/:branch/:slug"
    },
    {
      "source": "/sermons/:branch/:series/:slug",
      "destination": "https://hope-media.cowens-09f.workers.dev/media/:branch/:series/:slug"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "calendar.hopejc.org"
        }
      ],
      "destination": "https://hope-media.cowens-09f.workers.dev/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dashboard.hopejc.org"
        }
      ],
      "destination": "https://hope-media.cowens-09f.workers.dev/$1"
    },
    {
      "source": "/events/img/:path*",
      "destination": "https://hope-media.cowens-09f.workers.dev/events/img/:path*"
    },
    {
      "source": "/events/:slug",
      "destination": "https://hope-media.cowens-09f.workers.dev/events/:slug"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "media.hopejc.org"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "calendar.hopejc.org"
        }
      ],
      "destination": "/calendar",
      "permanent": false,
      "missing": [
        {
          "type": "query",
          "key": "next"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dashboard.hopejc.org"
        }
      ],
      "destination": "/dashboard",
      "permanent": false,
      "missing": [
        {
          "type": "query",
          "key": "next"
        }
      ]
    }
  ]
}
